# Compose reads .env. Do not commit it.
# Generate missing service & infra credentials with scripts/configure-internal-tokens.ps1.

# Internal service tokens & JWT
JWT_SIGNING_KEY=
AI_GATEWAY_TOKEN=
AI_INGEST_TOKEN=
MCP_TOKEN=
ARTICLE_USER_RPC_TOKEN=
COMMENT_USER_RPC_TOKEN=

# Infrastructure credentials
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MEILI_MASTER_KEY=
GF_SECURITY_ADMIN_PASSWORD=

# Nacos authentication (NACOS_AUTH_TOKEN must be Base64-encoded >= 32 bytes)
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# AI Embedding configuration
AI_EMBEDDING_PROVIDER=hash
AI_EMBEDDING_API_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# External LLM providers (optional; configure via scripts/configure-ai-keys.ps1)
QWEN_API_KEY=
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-2.4t-a95b
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.6-pro
